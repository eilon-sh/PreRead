{
  "plugins": ["prettier-plugin-ejs"],
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.ejs",
      "options": {
        "parser": "html",
        "htmlWhitespaceSensitivity": "css"
      }
    }
  ]
}