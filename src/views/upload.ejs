<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <%- include('partials/seo') %>
    <%- include('partials/theme-init') %>
    <%- include('partials/styles') %>
    <link rel="stylesheet" href="/css/shared/nav.css" />
    <link rel="stylesheet" href="/css/pages/upload.css" />
    <%- include('partials/csrf-meta') %>
    <%- include('partials/alerts-head') %>
    <script defer src="/js/shared/format.js"></script>
    <script defer src="/js/shared/api.js"></script>
  </head>
  <body>
    <%- include('partials/skip-link') %>
    <%- include('partials/nav') %>
    <main id="main-content" class="container app-container" tabindex="-1">
      <section class="card mb-4">
        <div class="card-body">
          <form id="uploadForm" enctype="multipart/form-data">
            <div class="mb-3">
              <label for="pdf" class="form-label fw-semibold">קובץ PDF עד 100 דפים ועד 10 MB</label>
              <div class="file-picker">
                <div class="file-input-wrap d-flex align-items-center flex-wrap gap-2">
                  <input
                    type="file"
                    id="pdf"
                    name="pdf"
                    class="file-input-native"
                    accept="application/pdf"
                    required
                  />
                  <label for="pdf" class="btn btn-secondary file-input-btn mb-0">בחר קובץ</label>
                  <span id="fileName" class="file-name text-muted" title="">לא נבחר קובץ</span>
                </div>
              </div>
              <p class="text-muted upload-help-text mb-1">
                בודקים את המערכת? הנה כמה
                <a
                  href="https://drive.google.com/drive/folders/1H5Ur_gJ5GFudN0hL-3FJs5u8KYHWfQSl"
                  target="_blank"
                  rel="noopener noreferrer"
                  >קבצים</a
                >
                שאפשר לנסות איתם.
              </p>
              <p class="text-muted upload-help-text mb-0">
                לא בטוחים מה הרמה? בדקו כאן:
                <a
                  href="https://europa-school.co.uk/language-level-test/"
                  target="_blank"
                  rel="noopener noreferrer"
                  >מבחן רמת שפה</a
                >
              </p>
            </div>
            <div class="upload-actions d-flex align-items-stretch gap-2">
              <div class="select-field input-group">
                <span class="select-field-label input-group-text">רמת CEFR</span>
                <select id="minCefr" name="minCefr" class="form-select" aria-label="רמת CEFR">
                  <option value="B1">B1 ומעלה</option>
                  <option value="B2">B2 ומעלה</option>
                  <option value="C1">C1 ומעלה</option>
                  <option value="C2">C2 בלבד</option>
                </select>
              </div>
              <button type="submit" class="btn btn-primary upload-submit-btn" id="uploadBtn">
                העלה וחלץ מילים
              </button>
            </div>
          </form>
        </div>
      </section>

      <section class="card mb-4">
        <div class="card-body">
          <h2 class="h5 mb-3">מסמכים קיימים</h2>
          <div id="documentsList" class="documents-list d-flex flex-column gap-2">
            <p class="text-muted mb-0">טוען...</p>
          </div>
        </div>
      </section>
    </main>
    <script defer src="/js/pages/upload.js"></script>
    <%- include('partials/scripts') %>
  </body>
</html>
