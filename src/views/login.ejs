<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <%- include('partials/seo') %>
    <%- include('partials/theme-init') %>
    <%- include('partials/styles') %>
    <link rel="stylesheet" href="/css/shared/auth.css" />
    <link rel="stylesheet" href="/css/pages/login.css" />
    <%- include('partials/alerts-head') %>
    <script defer src="/js/shared/auth-social.js"></script>
  </head>
  <body class="auth-page d-flex align-items-center justify-content-center min-vh-100">
    <%- include('partials/theme-toggle') %>
    <main class="container auth-container py-4">
      <div class="card auth-card shadow">
        <div class="card-body p-4 p-md-5">
          <h1 class="text-center h3 mb-1">התחברות</h1>
          <p class="subtitle text-center text-muted mb-4">ברוך שובך! המשך ללמוד מילים חדשות</p>
          <%- include('partials/google-signin') %>
          <form id="loginForm">
            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">אימייל</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                required
                autocomplete="email"
              />
            </div>
            <div class="mb-3">
              <div
                class="form-label-row d-flex align-items-center justify-content-between gap-2 mb-1"
              >
                <label for="password" class="form-label fw-semibold mb-0">סיסמה</label>
                <%#
                  שירות איפוס הסיסמה (Resend) מוכן ועובד - השתמשנו בו רק כדי לבדוק שהזרימה פועלת.
                  מוסתר בפרודקשן; בעתיד אפשר להציג שוב אחרי אימות דומיין אם נרצה להפעיל.
                %>
                <% if (!isProduction) { %>
                <a href="/forgot-password" class="auth-forgot-link small">שכחת סיסמה?</a>
                <% } %>
              </div>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                required
                autocomplete="current-password"
              />
            </div>
            <button type="submit" class="btn btn-primary w-100">התחבר</button>
          </form>

          <p class="auth-switch text-center text-muted mt-4 mb-0">
            אין לך חשבון? <a href="/register">הירשם כאן</a>
          </p>
        </div>
      </div>
    </main>
    <script defer src="/js/pages/login.js"></script>
    <%- include('partials/scripts') %>
  </body>
</html>
