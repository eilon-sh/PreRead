<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <%- include('partials/seo') %>
    <%- include('partials/theme-init') %>
    <%- include('partials/styles') %>
    <link rel="stylesheet" href="/css/shared/auth.css" />
    <link rel="stylesheet" href="/css/pages/forgot-password.css" />
    <%- include('partials/alerts-head') %>
  </head>
  <body class="auth-page d-flex align-items-center justify-content-center min-vh-100">
    <%- include('partials/theme-toggle') %>
    <main class="container auth-container py-4">
      <div class="card auth-card shadow">
        <div class="card-body p-4 p-md-5">
          <h1 class="text-center h3 mb-1">שכחתי סיסמה</h1>
          <p class="subtitle text-center text-muted mb-4">
            הזן את כתובת האימייל ונשלח לך קישור לאיפוס הסיסמה
          </p>
          <form id="forgotForm">
            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">אימייל</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                required
                autocomplete="email"
              />
            </div>
            <button type="submit" class="btn btn-primary w-100">שלח קישור לאיפוס</button>
          </form>

          <p class="auth-switch text-center text-muted mt-4 mb-0">
            <a href="/login">חזרה להתחברות</a>
          </p>
        </div>
      </div>
    </main>
    <script defer src="/js/pages/forgot-password.js"></script>
    <%- include('partials/scripts') %>
  </body>
</html>
