<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <%- include('partials/seo') %>
    <%- include('partials/theme-init') %>
    <%- include('partials/styles') %>
    <link rel="stylesheet" href="/css/shared/nav.css" />
    <link rel="stylesheet" href="/css/pages/words.css" />
    <link rel="stylesheet" href="/css/print.css" />
    <%- include('partials/csrf-meta') %>
    <%- include('partials/alerts-head') %>
    <script defer src="/js/shared/format.js"></script>
    <script defer src="/js/shared/api.js"></script>
  </head>
  <body>
    <%- include('partials/skip-link') %>
    <%- include('partials/nav') %>
    <main id="main-content" class="container app-container" tabindex="-1">
      <header class="words-page-header">
        <h1 class="h3 mb-1">מילים</h1>
        <p class="document-filename text-muted mb-1" id="documentFilename" hidden></p>
        <!-- <p class="subtitle text-muted mb-0">רשימת אוצר המילים שלך ללימוד ולהדפסה</p> -->
      </header>

      <section class="card mb-4 words-card">
        <div class="card-body">
          <div class="filters words-toolbar mb-3" id="wordsToolbar">
            <a
              href="#"
              class="btn btn-secondary words-toolbar-secondary"
              id="printCardsLink"
              hidden
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9V2h12v7" />
                <path
                  d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
                />
                <rect x="6" y="14" width="12" height="8" />
              </svg>
              <span>הדפס כרטיסים</span>
            </a>
            <button
              type="button"
              class="btn btn-outline-danger words-toolbar-secondary"
              id="deleteDocBtn"
              hidden
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 6h18" />
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                <path d="M10 11v6" />
                <path d="M14 11v6" />
              </svg>
              <span>מחק מסמך</span>
            </button>
            <p class="words-summary text-muted mb-0" id="wordsSummary" hidden></p>
          </div>
          <div id="wordsTable" class="table-wrap table-responsive" aria-live="polite">
            <div class="words-loading" role="status">
              <div class="words-loading-bar" aria-hidden="true"></div>
              <p class="text-muted mb-0">טוען מילים...</p>
            </div>
          </div>
        </div>
      </section>
    </main>
    <script defer src="/js/pages/words.js"></script>
    <%- include('partials/scripts') %>
  </body>
</html>
