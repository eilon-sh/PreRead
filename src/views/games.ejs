<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <%- include('partials/seo') %>
    <%- include('partials/theme-init') %>
    <%- include('partials/styles') %>
    <link rel="stylesheet" href="/css/shared/nav.css" />
    <link rel="stylesheet" href="/css/pages/games.css" />
    <%- include('partials/csrf-meta') %>
    <%- include('partials/alerts-head') %>
    <script defer src="/js/shared/format.js"></script>
    <script defer src="/js/shared/api.js"></script>
  </head>
  <body>
    <%- include('partials/skip-link') %>
    <%- include('partials/nav') %>
    <main id="main-content" class="container app-container" tabindex="-1">
      <h1 class="h3">משחקי מילים</h1>
      <p class="subtitle text-muted">תרגל את האוצר מילים שלך בדרך מהנה וצבור XP</p>

      <div id="xpToast" class="xp-toast hidden"></div>

      <div id="emptyState" class="card game-empty text-center hidden mb-4">
        <div class="card-body py-5">
          <p class="mb-0">
            אין מספיק מילים למשחק. <a href="/upload">העלה PDF</a> וחלץ מילים כדי להתחיל.
          </p>
        </div>
      </div>

      <div id="gamePicker" class="game-picker row g-3 mb-4"></div>

      <h2 id="gameTitle" class="game-active-title h5 hidden"></h2>
      <p id="scoreBar" class="game-score-bar fw-semibold text-muted hidden"></p>
      <div id="gameArea" class="hidden"></div>
    </main>
    <script defer src="/js/pages/games.js"></script>
    <%- include('partials/scripts') %>
  </body>
</html>
