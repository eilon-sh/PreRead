<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4f46e5" />
    <title>לימוד - Preread</title>
    <%- include('partials/theme-init') %>
    <%- include('partials/styles') %>
    <link rel="stylesheet" href="/css/shared/nav.css" />
    <link rel="stylesheet" href="/css/pages/study.css" />
    <%- include('partials/csrf-meta') %>
    <%- include('partials/alerts-head') %>
    <script defer src="/js/shared/format.js"></script>
    <script defer src="/js/shared/api.js"></script>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main class="container app-container">
      <div class="study-title-row">
        <div class="study-title-text">
          <h1 class="h3">לימוד עם SM-2</h1>
          <p class="subtitle text-muted">פלאשקארדים עם חזרה מרווחת - דרג את הידע שלך</p>
        </div>
        <section class="study-stats" id="statsBar" aria-live="polite" aria-label="סטטיסטיקות לימוד">
          <div class="study-stats-row" id="dueCount">
            <span class="study-stat-chip study-stat-loading">טוען...</span>
          </div>
        </section>
      </div>

      <div id="xpToast" class="xp-toast hidden"></div>

      <section class="card mb-4 flashcard-container text-center" id="flashcardArea">
        <div class="card-body" style="min-height: 300px">
          <p class="text-muted mb-0">טוען כרטיסים...</p>
        </div>
      </section>
    </main>
    <script defer src="/js/pages/study.js"></script>
    <%- include('partials/scripts') %>
  </body>
</html>
