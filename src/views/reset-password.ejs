<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4f46e5" />
    <title>איפוס סיסמה - Preread</title>
    <%- include('partials/theme-init') %>
    <%- include('partials/styles') %>
    <%- include('partials/alerts-head') %>
  </head>
  <body class="auth-page d-flex align-items-center justify-content-center min-vh-100">
    <%- include('partials/theme-toggle') %>
    <main class="container auth-container py-4">
      <div class="card auth-card shadow">
        <div class="card-body p-4 p-md-5">
          <h1 class="text-center h3 mb-1">סיסמה חדשה</h1>
          <p class="subtitle text-center text-muted mb-4">בחר סיסמה חדשה לחשבון שלך</p>
          <form id="resetForm" class="hidden">
            <div class="mb-3">
              <label for="password" class="form-label fw-semibold">סיסמה חדשה</label>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                required
                minlength="8"
                autocomplete="new-password"
              />
            </div>
            <div class="mb-3">
              <label for="passwordConfirm" class="form-label fw-semibold">אימות סיסמה</label>
              <input
                type="password"
                class="form-control"
                id="passwordConfirm"
                name="passwordConfirm"
                required
                minlength="8"
                autocomplete="new-password"
              />
            </div>
            <button type="submit" class="btn btn-primary w-100">עדכן סיסמה</button>
          </form>

          <p class="auth-switch text-center text-muted mt-4 mb-0">
            <a href="/login">חזרה להתחברות</a>
          </p>
        </div>
      </div>
    </main>
    <script src="/js/pages/reset-password.js"></script>
    <%- include('partials/scripts') %>
  </body>
</html>
