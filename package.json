{
  "name": "cefr-flashcards",
  "version": "1.0.0",
  "description": "PDF to CEFR vocabulary flashcards with SM-2 spaced repetition",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pm2:start": "pm2 start src/server.js --name preread",
    "pm2:monit": "pm2 monit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node test/e2e.js",
    "check": "prettier --check .",
    "fix": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.6.23",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pm2": "^7.0.3",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.4",
    "prettier-plugin-ejs": "^1.0.3",
    "prisma": "^6.19.3"
  }
}
