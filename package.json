{
	"name": "cefr-flashcards",
	"version": "1.0.0",
	"description": "PDF to CEFR vocabulary flashcards with SM-2 spaced repetition",
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"main": "src/server.js",
	"scripts": {
		"start": "node src/server.js",
		"dev": "node --watch src/server.js",
		"pm2:start": "pm2 start src/server.js --name preread",
		"pm2:monit": "pm2 monit",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"postinstall": "prisma generate",
		"test": "node test/e2e.js",
		"test:unit": "node test/parseIntUtils.test.js && node test/textSplitter.test.js && node test/bedrockExtraction.test.js",
		"check": "biome check . && prettier --check \"src/views/**/*.ejs\"",
		"fix": "biome check --write . && prettier --write \"src/views/**/*.ejs\""
	},
	"dependencies": {
		"@aws/bedrock-token-generator": "^1.1.0",
		"@mote-software/markitdown": "^1.2.0",
		"@picocss/pico": "^2.1.1",
		"@prisma/client": "^6.19.3",
		"better-auth": "^1.6.23",
		"bootstrap": "^5.3.8",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"csrf-csrf": "^4.0.3",
		"dotenv": "^17.4.2",
		"ejs": "^6.0.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"file-type": "^22.0.1",
		"helmet": "^8.2.0",
		"hpp": "^0.2.3",
		"morgan": "^1.11.0",
		"multer": "^2.2.0",
		"pm2": "^7.0.3",
		"resend": "^6.17.1",
		"sweetalert2": "^11.26.25"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@pdf-lib/fontkit": "^1.1.1",
		"pdf-lib": "^1.17.1",
		"prettier": "^3.9.4",
		"prettier-plugin-ejs": "^1.0.3",
		"prisma": "^6.19.3"
	}
}
