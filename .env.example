PORT=3000
NODE_ENV=development
# AWS RDS PostgreSQL
# Local/dev: use a dedicated database (e.g. preread_dev) so migrate never touches prod tables.
DATABASE_URL=postgresql://USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/preread_dev?sslmode=require
# Optional: keep production URL separate (never used by npm run dev)
# DATABASE_URL_PROD=postgresql://USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/postgres?sslmode=require
BETTER_AUTH_SECRET=
CSRF_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Production over plain HTTP (EC2 public IP): use http://YOUR_IP — Helmet disables HSTS/COOP.
# Production with TLS (domain + nginx/ALB): use https://your.domain — enables HSTS + Secure cookies.
TRUST_PROXY=false
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=5
RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=3
RATE_LIMIT_PASSWORD_RESET_EMAIL_WINDOW_MS=3600000
# IAM credentials for S3 uploads from the Express app.
# For local dev, set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# On AWS (EC2/ECS/Lambda), use an IAM Role instead - no keys in env needed.
AWS_REGION=us-east-1
# Inference profile ID for Bedrock (not the bare foundation model ID).
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOAD_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Preread <onboarding@resend.dev>
