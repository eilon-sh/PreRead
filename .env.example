PORT=3000
NODE_ENV=development
# AWS RDS PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/preread?sslmode=require
BETTER_AUTH_SECRET=
CSRF_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=5
RATE_LIMIT_EXTRACT_MAX=60
RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=3
RATE_LIMIT_PASSWORD_RESET_EMAIL_WINDOW_MS=3600000
# IAM credentials - used by token generator to create short-term Bedrock bearer tokens.
# For local dev, set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# On AWS (EC2/ECS/Lambda), use an IAM Role instead — no keys in env needed.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_TEMPERATURE=0
# BEDROCK_TOP_P=1
# BEDROCK_EXTRACTION_CACHE=false
BEDROCK_TOKEN_EXPIRES_SECONDS=43200
MOCK_BEDROCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Preread <onboarding@resend.dev>