PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/preread_dev?sslmode=require
BETTER_AUTH_SECRET=
CSRF_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=5
RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=3
RATE_LIMIT_PASSWORD_RESET_EMAIL_WINDOW_MS=3600000
# IAM credentials for S3 uploads from the Express app.
# On AWS (EC2/ECS/Lambda), use an IAM Role instead - no keys in env needed.
# Local testing: either set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY below,
# or run `aws configure` / `aws sso login` so the SDK picks up ~/.aws credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Inference profile ID for Bedrock (not the bare foundation model ID).
# Lambda only - not read by the Express app.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Lambda only - optional; when set, Lambda loads DATABASE_URL from Secrets Manager.
# DATABASE_URL_SECRET_ARN=
S3_UPLOAD_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
